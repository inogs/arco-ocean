#
# Every day: a watchdog disabled for inactivity is enabled again within a day.

[Unit]
Description=ARCO-OCEAN: keep the forecast watchdog's schedule enabled, daily

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
